GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# SUPABASE AUTH (secondary identity / protected-route layer)
# Firebase/Firestore remains the primary application database.
VITE_SUPABASE_URL="https://pvicuqkichylokbywxvo.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
# Set to true only after existing Firebase users have been provisioned in Supabase Auth.
VITE_SUPABASE_AUTH_REQUIRED="false"

