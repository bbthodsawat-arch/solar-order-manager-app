# Gemini AI
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL used for OAuth callback configuration
APP_URL="https://your-domain.example"

# Supabase — primary database and authentication
# Use the project's URL and publishable/anon key. Never expose a secret/service-role key in VITE_* variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
