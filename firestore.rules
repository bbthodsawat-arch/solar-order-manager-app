rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'b.b.thodsawat@gmail.com';
    }

    function isAdmin() {
      return isOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // User profiles are the authorization source for the application.
    // Prevent authenticated users from granting themselves elevated roles.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && userId == request.auth.uid
        && (request.resource.data.role == 'staff' || isOwner());
      allow update: if isAdmin()
        || (signedIn()
          && userId == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.permissions == resource.data.permissions
          && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // Known application collections remain authenticated-only while the
    // collection/CRUD/role matrix is completed. Unknown collections are denied.
    match /transactions/{document=**} {
      allow read, write: if signedIn();
    }
    match /recurring_transactions/{document=**} {
      allow read, write: if signedIn();
    }
    match /categories/{document=**} {
      allow read, write: if signedIn();
    }
    match /quick_notes/{document=**} {
      allow read, write: if signedIn();
    }
    match /customers/{document=**} {
      allow read, write: if signedIn();
    }
    match /appointments/{document=**} {
      allow read, write: if signedIn();
    }
    match /warranties/{document=**} {
      allow read, write: if signedIn();
    }
    match /settings/{document=**} {
      allow read, write: if signedIn();
    }
    match /config/{document=**} {
      allow read, write: if signedIn();
    }
    match /audit_logs/{document=**} {
      allow read, write: if signedIn();
    }

    // No catch-all authenticated write rule: collections not explicitly
    // mapped above are denied until audited and intentionally added.
  }
}
