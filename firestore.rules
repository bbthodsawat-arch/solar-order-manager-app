rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Emergency owner bootstrap remains explicit in Rules only. The client
    // application never uses email to elevate its local role.
    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'b.b.thodsawat@gmail.com';
    }

    function isAdmin() {
      return isOwner() || (userDoc() && userData().role == 'admin');
    }

    function hasPermission(permission) {
      return isAdmin()
        || (userDoc()
          && userData().status == 'active'
          && userData().permissions != null
          && userData().permissions[permission] == true);
    }

    match /users/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.role == 'staff';
      allow update: if isAdmin()
        || (signedIn()
          && userId == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.permissions == resource.data.permissions
          && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /transactions/{document=**} {
      allow read: if hasPermission('canViewDashboard') || hasPermission('canViewReports') || hasPermission('canAddTransactions');
      allow create: if hasPermission('canAddTransactions');
      allow update: if hasPermission('canEditTransactions');
      allow delete: if hasPermission('canDeleteTransactions');
    }

    match /recurring_transactions/{document=**} {
      allow read, create, update, delete: if hasPermission('canManageSettings');
    }

    match /categories/{document=**} {
      allow read, create, update, delete: if hasPermission('canManageSettings');
    }

    match /settings/{document=**} {
      allow read, create, update, delete: if hasPermission('canManageSettings');
    }

    match /config/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if hasPermission('canManageSettings');
    }

    match /audit_logs/{document=**} {
      allow read: if hasPermission('canViewAuditLogs');
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Business data: use existing application permissions. Customer/appointment/
    // warranty operations are part of the authenticated sales/order workflow.
    match /customers/{document=**} {
      allow read: if hasPermission('canViewDashboard') || hasPermission('canViewReports') || hasPermission('canAddTransactions');
      allow create: if hasPermission('canAddTransactions') || hasPermission('canManageSettings');
      allow update: if hasPermission('canEditTransactions') || hasPermission('canManageSettings');
      allow delete: if hasPermission('canDeleteTransactions') || hasPermission('canManageSettings');
    }

    match /appointments/{document=**} {
      allow read: if hasPermission('canViewDashboard') || hasPermission('canViewReports') || hasPermission('canAddTransactions');
      allow create: if hasPermission('canAddTransactions') || hasPermission('canManageSettings');
      allow update: if hasPermission('canEditTransactions') || hasPermission('canManageSettings');
      allow delete: if hasPermission('canDeleteTransactions') || hasPermission('canManageSettings');
    }

    match /warranties/{document=**} {
      allow read: if hasPermission('canViewDashboard') || hasPermission('canViewReports') || hasPermission('canAddTransactions');
      allow create: if hasPermission('canAddTransactions') || hasPermission('canManageSettings');
      allow update: if hasPermission('canEditTransactions') || hasPermission('canManageSettings');
      allow delete: if hasPermission('canDeleteTransactions') || hasPermission('canManageSettings');
    }

    match /quick_notes/{document=**} {
      allow read: if hasPermission('canViewDashboard') || hasPermission('canViewReports');
      allow create: if hasPermission('canAddTransactions');
      allow update: if hasPermission('canEditTransactions');
      allow delete: if hasPermission('canDeleteTransactions');
    }

    // No catch-all allow rule: unknown collections are denied by default.
  }
}
