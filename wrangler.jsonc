{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "solar-order-manager-app",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
